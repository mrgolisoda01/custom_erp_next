# Copy to workflow/environments.env and fill in. Do NOT commit environments.env.
# SSH must work with keys (no password prompt): test with  ssh $STAGING_SSH "bench version"

APP_NAME=your_custom_app

STAGING_SSH=frappe@staging.example.com
STAGING_BENCH_PATH=/home/frappe/frappe-bench
STAGING_SITE=staging.example.com
STAGING_BRANCH=staging

PROD_SSH=frappe@erp.example.com
PROD_BENCH_PATH=/home/frappe/frappe-bench
PROD_SITE=erp.example.com
PROD_BRANCH=main
